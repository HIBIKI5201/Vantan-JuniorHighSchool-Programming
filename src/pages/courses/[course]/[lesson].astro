---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
	const lessons = await getCollection("lessons");
	const courses = await getCollection("courses");
	const courseBySlug = new Map(courses.map((c) => [c.slug, c]));

	return Promise.all(
		lessons
			.filter((lesson) => {
				const [courseSlug, ...rest] = lesson.slug.split("/");
				const course = courseBySlug.get(courseSlug);
				const lessonOrder = rest.join("/");
				// ハブレッスンは /courses/<slug>/ 自体で表示するので、ここでは別ページを作らない。
				return course?.data.hubLesson !== lessonOrder;
			})
			.map(async (lesson) => {
				const [courseSlug, ...rest] = lesson.slug.split("/");
				const course = await getEntry("courses", courseSlug);
				return {
					params: { course: courseSlug, lesson: rest.join("/") },
					props: { lesson, course },
				};
			})
	);
}

const { lesson, course } = Astro.props;
const { Content } = await render(lesson);
const baseUrl = import.meta.env.BASE_URL;
const hasHub = course?.data.hubLesson !== undefined;
---
<Layout title={`${lesson.data.title} - ${course?.data.title ?? ""}`}>
	<p class="back-link"><a href={`${baseUrl}courses/${course?.slug}/`}>← {course?.data.title} 一覧</a></p>
	{lesson.data.status === "partial" && (
		<aside><p class="aside-icon">💡</p><p>{lesson.data.note ?? "このページは画像などが準備中です。"}</p></aside>
	)}
	<article>
		<Content />
	</article>
	{hasHub && (
		<a class="hub-return-button" href={`${baseUrl}courses/${course!.slug}/`}>
			← {course!.data.title}に戻る
		</a>
	)}
</Layout>
<style>
	.back-link a {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.back-link a:hover {
		color: var(--color-accent-ink);
	}

	.hub-return-button {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 3rem 0 1rem;
		padding: 1.1rem 1.5rem;
		background: var(--color-accent);
		color: white;
		font-weight: 700;
		font-size: 1.05rem;
		text-decoration: none;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
		transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
	}

	.hub-return-button:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lg);
		filter: brightness(1.08);
	}
</style>
